#!/bin/sh
cd ${0%/*} || exit 1    # Run from this directory

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

application=$(getApplication)

#------------------------------------------------------------------------------
# Resume: if a decomposed run exists, continue it from its latest write time
# (controlDict has startFrom latestTime), e.g. after the PC restarted.
if [ -d processor0 ]
then
    echo "Resuming $application from the latest time in processor*/"
    mv log.$application log.$application.$(date +%Y%m%d-%H%M%S) 2>/dev/null
else
    # Mesh
    runApplication blockMesh
    runApplication checkMesh

    runApplication decomposePar
fi

#------------------------------------------------------------------------------
# AdditiveFOAM
runParallel $application

#------------------------------------------------------------------------------
# Reconstruction
runApplication -overwrite reconstructPar
reconstructSolidificationData

touch case.foam    # open this file in ParaView

#------------------------------------------------------------------------------
