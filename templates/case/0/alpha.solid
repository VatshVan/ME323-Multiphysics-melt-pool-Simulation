     \\/     M anipulation  |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.solid;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Re-initialised by the solver from T and thermoPath at start-up
dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    "(top|bottom|sides)"
    {
        type            zeroGradient;
    }

    symmetry
    {
        type            symmetryPlane;
    }
}

// ************************************************************************* //
